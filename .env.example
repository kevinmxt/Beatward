# Local development overrides for compose.yaml.
# Copy to .env and never commit .env. Values below are placeholders.
POSTGRES_DB=beatward
POSTGRES_USER=beatward
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# If you change the values above, export matching DB_* variables before
# starting the backend, because the backend does not read .env directly:
# DB_URL=jdbc:postgresql://localhost:5432/beatward
# DB_USERNAME=beatward
# DB_PASSWORD=change-me-local

# Telegram notifications are disabled unless both values are set.
# BEATWARD_TELEGRAM_BOT_TOKEN=replace-with-bot-token
# BEATWARD_TELEGRAM_CHAT_ID=replace-with-chat-id

# User notification channel credentials are encrypted with AES-256-GCM.
# Generate with: openssl rand -base64 32
# Required once any notification_channel row exists.
# BEATWARD_CHANNEL_SECRET_KEY=
# Used in notification detail links; optional for local development.
# BEATWARD_PUBLIC_BASE_URL=http://localhost:5173

# Global SMTP used by EMAIL channels. Leave empty to disable email sending.
# BEATWARD_SMTP_HOST=
# BEATWARD_SMTP_PORT=587
# BEATWARD_SMTP_USERNAME=
# BEATWARD_SMTP_PASSWORD=
# BEATWARD_SMTP_FROM=
# BEATWARD_SMTP_STARTTLS=true
# BEATWARD_SMTP_SSL=false

# Require HTTPS for heartbeat reports (native TLS or X-Forwarded-Proto: https).
# HEARTBEAT_REQUIRE_HTTPS=false

# First startup only: creates the single admin account when app_user is empty.
# Generate the hash with:
#   docker run --rm httpd:2.4-alpine \
#     htpasswd -bnBC 12 "" 'your-password' | cut -d: -f2 | tr -d '\n'
# Prefix the output with {bcrypt} and keep the value in single quotes so the
# shell does not expand '$'. Existing accounts are never overwritten.
# BEATWARD_AUTH_BOOTSTRAP_USERNAME=admin
# BEATWARD_AUTH_BOOTSTRAP_PASSWORD_HASH='{bcrypt}$2y$12$...'
# BEATWARD_AUTH_COOKIE_SECURE=false
# Optional: registration/reset rate-limit key capacity (separate from login).
# BEATWARD_AUTH_ATTEMPT_RATE_LIMIT_MAX_KEYS=5000
